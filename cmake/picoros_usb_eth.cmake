# What an application calls after project() and its SDK's own init,
# pico_sdk_init() for rp2040:
#
#   picoros_usb_eth_init(TYPES_HEADER <header> [TYPES_DIR <dir>] [DEBUG])
#     Once. Builds the platform, zenoh-pico with the options rmw_zenoh_cpp
#     needs, Micro-CDR, and Pico-ROS against <header>: the message types
#     generated by Pico-ROS's tools/type-gen, found in <dir>. DEBUG turns on
#     Pico-ROS's logging.
#
#   picoros_usb_eth_add_firmware(<target>)
#     Makes a firmware of <target>, an executable whose sources define
#     int app_main(void), which the platform's main() runs in a FreeRTOS task.
#
# The cache variables set in picoros_usb_eth_init() are defaults: give another
# value with -D, or with set(... CACHE ...) before the call.

function(picoros_usb_eth_init)
  cmake_parse_arguments(ARG "DEBUG" "TYPES_HEADER;TYPES_DIR" "" ${ARGN})
  if(NOT ARG_TYPES_HEADER)
    message(FATAL_ERROR "picoros_usb_eth_init: TYPES_HEADER is required.")
  endif()

  set(third_party "${PICOROS_USB_ETH_DIR}/third_party")

  set(USB_NET_DEVICE_IP "192.168.7.1" CACHE STRING "board address on the USB link")
  set(USB_NET_HOST_IP "192.168.7.2" CACHE STRING "address leased to the host, and SNTP server")
  set(USB_NET_NETMASK "255.255.255.0" CACHE STRING "USB link netmask")
  set(ZENOH_CONFIG_MODE "client" CACHE STRING "client or peer")
  set(ZENOH_CONFIG_CONNECT "tcp/${USB_NET_HOST_IP}:7447" CACHE STRING "router endpoint, the host end of the USB link")

  include("${PICOROS_USB_ETH_PLATFORM_DIR}/platform.cmake")

  set(BUILD_SHARED_LIBS OFF)

  # What the stack relies on, forced over zenoh-pico's defaults.
  set(Z_FEATURE_LINK_TCP 1 CACHE STRING "" FORCE)
  set(Z_FEATURE_LINK_UDP_MULTICAST 0 CACHE STRING "" FORCE)
  set(Z_FEATURE_LINK_UDP_UNICAST 0 CACHE STRING "" FORCE)
  set(Z_FEATURE_SCOUTING 0 CACHE STRING "" FORCE)
  set(Z_FEATURE_LINK_SERIAL 0 CACHE STRING "" FORCE)
  set(Z_FEATURE_LINK_SERIAL_USB 0 CACHE STRING "" FORCE)
  set(Z_FEATURE_PUBLICATION 1 CACHE STRING "" FORCE)
  set(Z_FEATURE_SUBSCRIPTION 1 CACHE STRING "" FORCE)
  set(Z_FEATURE_QUERYABLE 1 CACHE STRING "" FORCE)
  set(Z_FEATURE_QUERY 1 CACHE STRING "" FORCE)
  set(Z_FEATURE_MULTI_THREAD 1 CACHE STRING "" FORCE)
  # Without liveliness tokens the node never appears in the ROS graph.
  set(Z_FEATURE_LIVELINESS 1 CACHE STRING "" FORCE)
  # Per-publisher reliability, in-place payloads and transient local.
  set(Z_FEATURE_UNSTABLE_API 1 CACHE STRING "" FORCE)
  set(Z_FEATURE_ADVANCED_PUBLICATION 1 CACHE STRING "" FORCE)
  # A firmware restarts the board on a lost session instead: closing and
  # reopening a session hangs zenoh-pico's rpi_pico port.
  set(Z_FEATURE_AUTO_RECONNECT 0 CACHE STRING "" FORCE)

  # zenoh-pico expires the router after the shorter of the two leases, and
  # rmw_zenohd's default config sends a keepalive only every 30 s (lease 60 s,
  # keep_alive 2). At the default 10 s an idle session expires between two.
  set(Z_TRANSPORT_LEASE 60000 CACHE STRING "link lease in milliseconds")
  # A stopped router shows only when a keepalive fails to send, and one is
  # tried every lease / factor: 5 s instead of 20. It goes out only if nothing
  # else has for that long.
  set(Z_TRANSPORT_LEASE_EXPIRE_FACTOR 12 CACHE STRING "keepalive attempts per lease")

  add_subdirectory("${third_party}/zenoh-pico" zenoh-pico)
  target_link_libraries(zenohpico_static PRIVATE ${PICOROS_USB_ETH_ZENOH_DEPS})

  add_library(microcdr STATIC
    "${third_party}/Micro-CDR/src/c/common.c"
    "${third_party}/Micro-CDR/src/c/types/array.c"
    "${third_party}/Micro-CDR/src/c/types/basic.c"
    "${third_party}/Micro-CDR/src/c/types/sequence.c"
    "${third_party}/Micro-CDR/src/c/types/string.c"
  )
  target_include_directories(microcdr PUBLIC
    "${third_party}/Micro-CDR/include"
    "${third_party}/Pico-ROS/thirdparty/config"
  )

  add_library(picoros STATIC
    "${third_party}/Pico-ROS/src/picoros.c"
    "${third_party}/Pico-ROS/src/picoserdes.c"
  )
  target_include_directories(picoros PUBLIC
    "${third_party}/Pico-ROS/src"
    ${ARG_TYPES_DIR}
  )
  target_compile_definitions(picoros PUBLIC USER_TYPE_FILE="${ARG_TYPES_HEADER}")
  if(ARG_DEBUG)
    target_compile_definitions(picoros PUBLIC PICOROS_DEBUG)
  endif()
  target_link_libraries(picoros PUBLIC
    zenohpico::lib
    microcdr
    ${PICOROS_USB_ETH_LIBRARY_DEPS}
  )
endfunction()

function(picoros_usb_eth_add_firmware target)
  target_compile_definitions(${target} PRIVATE
    ZENOH_CONFIG_MODE="${ZENOH_CONFIG_MODE}"
    ZENOH_CONFIG_CONNECT="${ZENOH_CONFIG_CONNECT}"
  )
  target_link_libraries(${target} PRIVATE picoros)
  picoros_usb_eth_platform_firmware(${target})
  target_link_libraries(${target} PRIVATE zenohpico::lib)
endfunction()
